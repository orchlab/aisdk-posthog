{
  "name": "aisdk-posthog",
  "version": "0.3.0",
  "description": "PostHog LLM analytics integration for the Vercel AI SDK (OpenTelemetry-based)",
  "author": "Miro K <mirik.kubal@gmail.com>",
  "contributors": [
    "Orchestra"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orchlab/aisdk-posthog.git"
  },
  "bugs": {
    "url": "https://github.com/orchlab/aisdk-posthog/issues"
  },
  "homepage": "https://github.com/orchlab/aisdk-posthog#readme",
  "keywords": [
    "ai-sdk",
    "vercel-ai-sdk",
    "posthog",
    "analytics",
    "llm",
    "ai",
    "observability",
    "telemetry",
    "opentelemetry"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./ai": {
      "import": {
        "types": "./dist/ai.d.ts",
        "default": "./dist/ai.js"
      },
      "require": {
        "types": "./dist/ai.d.cts",
        "default": "./dist/ai.cjs"
      }
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run clean && pnpm run typecheck && pnpm run test && pnpm run build",
    "example:generate": "tsx examples/generate-text.ts",
    "example:stream": "tsx examples/stream-text.ts",
    "example:agent": "tsx examples/agent-with-subagent.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^2.6.0",
    "@opentelemetry/core": "^2.5.1",
    "@opentelemetry/sdk-trace-base": "^2.5.1",
    "llm-info": "^1.0.69",
    "posthog-node": "^5.9.2"
  },
  "peerDependencies": {
    "@ai-sdk/otel": ">=1.0.0",
    "ai": ">=7.0.0"
  },
  "devDependencies": {
    "@ai-sdk/otel": "^1.0.127",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22",
    "ai": "^7.0.127",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "3.2.4",
    "zod": "^4.6.5"
  },
  "type": "module",
  "packageManager": "pnpm@10.14.0"
}
